{
  "title": "Agent Service",
  "uid": "agent-service",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (by tenant, priority)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(task_requests_total[1m])) by (tenant_id, priority)",
          "legendFormat": "{{tenant_id}} / {{priority}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(task_requests_total{status='failed'}[1m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Task Latency P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[1m])) / sum(rate(task_requests_total[1m]))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active Tasks",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "active_tasks",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 6,
      "title": "LLM Retry Rate",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 16, "w": 18, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(llm_retries_total[1m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
